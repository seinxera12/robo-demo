# ─────────────────────────────────────────────────────────────────────────────
# Lightweight Voice Demo — Environment Variables
# Copy this file to .env and fill in your values before running the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Groq API key — used for Whisper STT and LLaMA LLM (required)
GROQ_API_KEY=your_groq_api_key_here

# ── Optional API Keys ─────────────────────────────────────────────────────────

# Google Gemini API key — used as fallback LLM when Groq is unavailable (optional)
GEMINI_API_KEY=

# Tavily API key — enables live web search for SEARCH-intent queries (optional)
TAVILY_API_KEY=

# ── Model Selection ───────────────────────────────────────────────────────────

# Groq Whisper model for speech-to-text (default: whisper-large-v3-turbo)
GROQ_STT_MODEL=whisper-large-v3-turbo

# Groq LLaMA model for language generation (default: llama-3.3-70b-versatile)
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ── Voice Activity Detection ──────────────────────────────────────────────────

# Milliseconds of silence after speech before speech_end is emitted (default: 600)
VAD_SILENCE_MS=600

# Set to false to keep the mic open after VAD silence detection (useful for debugging)
# When true (default), the mic auto-closes and submits after the user stops speaking.
# When false, the mic stays open until the user manually clicks the button — useful for testing.
VITE_AUTO_CLOSE_MIC=true

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# Set to DEBUG to enable per-turn TTFA timing and full pipeline event logs
LOG_LEVEL=INFO

# ── Server Networking ─────────────────────────────────────────────────────────

# Host address for the FastAPI HTTP server (default: 0.0.0.0)
SERVER_HOST=0.0.0.0

# Port for the FastAPI HTTP server and /ws/ui WebSocket endpoint (default: 8000)
SERVER_PORT=8000

# Port for the AudioClient WebSocket endpoint /ws (default: 8765)
WS_PORT=8765
